# Copy to .env and fill in. Read from beside the script at startup, so the
# systemd timer picks it up too. Real environment variables win over this file.
#
# Everything here is optional: with no CALENDAR_ID (and no ics_url), the events
# band is simply not drawn.

# A calendar you have made public. Paste its ID, or the ?cid=... share link --
# either works. This is all a public calendar needs.
CALENDAR_ID=your-calendar-id@group.calendar.google.com

# How many events to draw. Also settable as "max_events" in the JSON config.
#CALENDAR_MAX_EVENTS=2

# Only if you want Google to expand recurring events instead of ics.py.
#CALENDAR_API_KEY=

# Only for a PRIVATE calendar. Fill these from gcal_setup.py; the refresh token
# is a standing key to your calendar, so keep this file out of git.
#CALENDAR_CLIENT_ID=
#CALENDAR_CLIENT_SECRET=
#CALENDAR_REFRESH_TOKEN=

# Overrides the derived feed URL, if you ever need a non-Google .ics.
#CALENDAR_ICS_URL=
