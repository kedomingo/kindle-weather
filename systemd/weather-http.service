[Unit]
Description=Serve the Kindle weather image on the local network
After=network.target

[Service]
# Python's stdlib server is plenty for one Kindle fetching one PNG.
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /var/lib/weather-display/www
User=weather
Group=weather
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
